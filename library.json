{
  "name": "ViraLink-MQTT-SDK",
  "version": "2.0.0-alpha.1",
  "description": "ThingsBoard-compatible MQTT device and gateway client with an at-least-once offline outbox, for ESP32 (Arduino and ESP-IDF).",
  "keywords": "thingsboard, viralink, mqtt, iot, telemetry, gateway, ota",
  "repository": {
    "type": "git",
    "url": "https://github.com/viralinkio/ViraLink-MQTT-SDK.git"
  },
  "license": "Apache-2.0",
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32", "native"],
  "headers": "ViraLink.h",
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "export": {
    "exclude": [".pio", ".idea", "docs", "test", "scripts", "cmake-build-*", "include", "lib", "CLAUDE.md", "platformio.ini", ".gitignore"]
  },
  "examples": [
    {
      "name": "basic_telemetry",
      "base": "examples/basic_telemetry",
      "files": ["basic_telemetry.ino"]
    },
    {
      "name": "rpc_and_attributes",
      "base": "examples/rpc_and_attributes",
      "files": ["rpc_and_attributes.ino"]
    },
    {
      "name": "gateway",
      "base": "examples/gateway",
      "files": ["gateway.ino"]
    },
    {
      "name": "ota",
      "base": "examples/ota",
      "files": ["ota.ino"]
    },
    {
      "name": "provisioning",
      "base": "examples/provisioning",
      "files": ["provisioning.ino"]
    },
    {
      "name": "persistence",
      "base": "examples/persistence",
      "files": ["persistence.ino"]
    },
    {
      "name": "arduino_client",
      "base": "examples/arduino_client",
      "files": ["arduino_client.ino"]
    },
    {
      "name": "secure_mtls",
      "base": "examples/secure_mtls",
      "files": ["secure_mtls.ino"]
    },
    {
      "name": "multi_network",
      "base": "examples/multi_network",
      "files": ["multi_network.ino"]
    }
  ]
}
